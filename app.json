{
  "expo": {
    "name": "bharosa",
    "slug": "bharosa",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F7F7F5"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Allow Bharosa to attach document photos.",
        "NSCameraUsageDescription": "Allow Bharosa to capture document photos."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F7F7F5",
        "foregroundImage": "./assets/icon.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Bharosa to attach document photos.",
          "cameraPermission": "Allow Bharosa to capture document photos."
        }
      ]
    ]
  }
}