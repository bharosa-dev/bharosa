{
  "expo": {
    "name": "Bharosa",
    "slug": "bharosa",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "bharosa",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1A2744"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.bharosa.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1A2744"
      },
      "package": "com.bharosa.app"
    },
    "plugins": [
      "expo-secure-store"
    ],
    "extra": {
      "eas": {
        "projectId": "23288131-1fa4-45b2-9b1b-1a10ca39effb"
      }
    }
  }
}
